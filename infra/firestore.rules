rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Client reads are owner-scoped. All writes go through the verified API.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /cases/{caseId} {
      allow read: if request.auth != null && resource.data.owner_uid == request.auth.uid;
      allow write: if false;
      match /{subcollection}/{document} {
        allow read: if request.auth != null && get(/databases/$(database)/documents/cases/$(caseId)).data.owner_uid == request.auth.uid;
        allow write: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
